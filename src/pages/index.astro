---
// src/pages/index.astro
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Familiar Choice Method™ | Rohit Singh</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-indigo-100 selection:text-indigo-900">
    
    <!-- Top Navigation -->
    <header class="max-w-5xl mx-auto px-6 py-8 flex justify-between items-center">
      <div class="font-bold text-xl tracking-tight text-slate-900">
        Familiar<span class="text-indigo-600">Choice</span>
      </div>
      <nav class="flex gap-6 text-sm font-medium text-slate-600">
        <a href="https://www.linkedin.com/in/rohit-singh-atx/" target="_blank" class="hover:text-indigo-600 transition-colors">LinkedIn</a>
        <a href="mailto:rohit@familiarchoice.com" class="hover:text-indigo-600 transition-colors">Email</a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6 pt-6 pb-24 space-y-16">

      <!-- Hero Section -->
      <section class="text-center space-y-8">
        <div class="inline-block px-3 py-1 bg-indigo-50 border border-indigo-100 rounded-full text-indigo-700 text-xs font-semibold uppercase tracking-wider">
          Thought Leadership & Marketing Strategy
        </div>
        
        <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
          The Familiar Choice Method™
        </h1>

        <!-- Extra-Large Quotation Headline with Attribution -->
        <div class="max-w-4xl mx-auto space-y-3">
          <blockquote class="text-2xl md:text-4xl lg:text-[2.55rem] font-semibold text-slate-800 leading-[1.3] italic tracking-tight">
            "I want to make it so that when someone needs what I do, I'm easy to find and they <strong class="text-indigo-600 font-black not-italic underline decoration-indigo-300 decoration-wavy decoration-1 underline-offset-8">call me first.</strong>"
          </blockquote>
          <p class="text-sm md:text-base font-medium text-slate-500 tracking-wide pt-1">
            — A Very Successful Business Owner
          </p>
        </div>

        <!-- Core Formula Banner -->
        <div class="bg-slate-900 text-white rounded-2xl p-8 shadow-xl max-w-2xl mx-auto mt-6 border border-slate-800">
          <p class="text-xs uppercase tracking-widest text-indigo-400 font-semibold mb-2">The Core Formula</p>
          <div class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-2">
            Familiarity + Visibility = Calls
          </div>
          <p class="text-slate-400 text-sm md:text-base">
            Every call is up for grabs. Will they choose you?
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a href="https://www.linkedin.com/in/rohit-singh-atx/" target="_blank" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-all">
            Connect on LinkedIn
          </a>
          <a href="mailto:rohit@familiarchoice.com" class="px-6 py-3 bg-white hover:bg-slate-100 text-slate-700 font-medium rounded-lg border border-slate-200 shadow-sm transition-all">
            Email Rohit
          </a>
        </div>
      </section>

      <hr class="border-slate-200" />

      <!-- Framework Breakdown Grid -->
      <section class="space-y-10">
        <div class="text-center space-y-2">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The Two Pillars of Growth</h2>
          <p class="text-slate-600">How to combine proactive brand exposure with active search demand.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          
          <!-- Relational Media Card -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-lg">
              01
            </div>
            <h3 class="text-xl font-bold text-slate-900">Relational Media</h3>
            <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide">Build emotional connection before the search</p>
            <p class="text-slate-600 text-sm leading-relaxed">
              TV, Radio, Magazines, YouTube, Social, Billboards, Retargeting, Display.
            </p>
            <ul class="space-y-2 text-slate-600 text-sm pt-2">
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                <span>Creates emotional connection through storytelling.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                <span>Makes sure they don't just <span class="font-semibold text-slate-900">know</span> you, but they <span class="font-semibold text-slate-900">like and trust</span> you.</span>
              </li>
            </ul>
            <div class="pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
              Goal: Move from unknown → known → liked → trusted (so they call you first).
            </div>
          </div>

          <!-- Directional Media Card -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-lg">
              02
            </div>
            <h3 class="text-xl font-bold text-slate-900">Directional Media</h3>
            <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide">Capture demand at the search</p>
            <p class="text-slate-600 text-sm leading-relaxed">
              Google Ads (PPC), Local SEO, and call extensions.
            </p>
            <ul class="space-y-2 text-slate-600 text-sm pt-2">
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                Show up when customers actively search (e.g., “AC repair near me”).
              </li>
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                Turns familiarity into calls, appointments, and revenue.
              </li>
            </ul>
            <div class="pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
              Goal: Make sure you're easy to find the exact moment they need you.
            </div>
          </div>

        </div>

        <!-- Connecting Blocks mapping to the owner's goal -->
        <div class="grid md:grid-cols-2 gap-6 pt-2">
          <div class="bg-indigo-50/70 border border-indigo-100 p-6 rounded-xl text-center space-y-2">
            <p class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Pillar 1 Connects To</p>
            <h4 class="text-lg font-bold text-slate-900">"They know, like, and trust you"</h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              Relational media builds emotional connection so that when they search, you are the trusted choice they want to call first.
            </p>
          </div>

          <div class="bg-indigo-50/70 border border-indigo-100 p-6 rounded-xl text-center space-y-2">
            <p class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Pillar 2 Connects To</p>
            <h4 class="text-lg font-bold text-slate-900">"You're easy to find"</h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              Directional media ensures you capture active search demand so you don't lose the call to a competitor.
            </p>
          </div>
        </div>

        <!-- Logic-Driven Convergence Highlight Box -->
        <div class="bg-gradient-to-r from-indigo-900 to-slate-900 text-white p-8 md:p-10 rounded-2xl text-center space-y-6 shadow-lg border border-indigo-800">
          <div class="flex justify-center items-center gap-3 text-sm font-semibold tracking-wider uppercase text-indigo-300">
            <span>Relational</span>
            <span>+</span>
            <span>Directional</span>
            <span>=</span>
            <span class="text-white underline decoration-indigo-400">Familiar Choice</span>
          </div>
          
          <div class="text-lg md:text-xl text-slate-200 max-w-3xl mx-auto leading-relaxed space-y-4">
            <p>If you aren't easy to find, your competitors get the call and you don't.</p>
            <p>If you are easy to find but they don't know, like, and trust you, you'll just get price-shopped against a stranger.</p>
            <p class="font-bold text-white text-xl md:text-2xl pt-3">When you are easy to find AND they already know, like, and trust you... you become the first call.</p>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section class="bg-white p-8 md:p-10 rounded-2xl border border-slate-200 shadow-sm space-y-6">
        <h2 class="text-2xl font-bold text-slate-900">About Rohit Singh</h2>
        <p class="text-slate-600 leading-relaxed text-base">
          For 15 years, I have helped local service businesses understand a simple truth: every call is up for grabs. When life triggers a search, customers don’t just want the 'best' provider—they want someone easy to find and someone they already trust. I want to make it so that when someone needs what you do, you're easy to find and they call you first. That’s what <strong class="text-slate-900">The Familiar Choice Method™</strong> is built to achieve.
        </p>
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <span class="text-sm font-medium text-slate-700">Want to apply it to your business?</span>
          <div class="flex gap-3">
            <a href="https://www.linkedin.com/in/rohit-singh-atx/" target="_blank" class="text-sm text-indigo-600 hover:underline font-semibold">LinkedIn</a>
            <span class="text-slate-300">•</span>
            <a href="mailto:rohit@familiarchoice.com" class="text-sm text-indigo-600 hover:underline font-semibold">Email Me</a>
          </div>
        </div>
      </section>

      <!-- Revenue Leakage Calculator Section -->
      <section class="bg-white p-8 md:p-10 rounded-2xl border border-rose-100 shadow-md space-y-8">
        
        <div class="text-center space-y-3">
          <div class="inline-block px-4 py-1.5 bg-rose-50 border border-rose-100 rounded-full text-rose-700 text-sm font-bold uppercase tracking-wider">
            Revenue Leakage Calculator
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">How Much Revenue Are You Losing to Competitors?</h2>
          <p class="text-slate-600 max-w-xl mx-auto text-base md:text-lg">
            Enter your weekly numbers below. We convert your weekly metrics into monthly and annual revenue leakage.
          </p>

          <!-- Industry Quick-Presets -->
          <div class="flex flex-wrap justify-center gap-3 pt-3">
            <button id="presetTrade" class="preset-btn px-5 py-2.5 text-sm font-bold rounded-full border border-indigo-600 bg-indigo-50 text-indigo-700 transition-all shadow-sm">
              🛠️ Trade / Home Services
            </button>
            <button id="presetMedical" class="preset-btn px-5 py-2.5 text-sm font-bold rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-600 hover:text-indigo-600 transition-all shadow-sm">
              🩺 Healthcare
            </button>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-10 items-center pt-4">
          <!-- Controls / Input Fields -->
          <div class="space-y-6">
            
            <!-- Input 1: Service Fee / Consult Fee -->
            <div class="space-y-2">
              <label for="serviceFee" id="serviceFeeLabel" class="block text-sm font-semibold text-slate-700">Service Call / Dispatch Fee</label>
              <div class="relative rounded-lg shadow-sm">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500 font-semibold">$</div>
                <input type="number" id="serviceFee" min="0" step="any" value="50" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-8 pr-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
              </div>
            </div>

            <!-- Checkbox: Deduct Fee from Sale -->
            <div class="flex items-center gap-3 pt-1 pb-1">
              <input type="checkbox" id="deductFee" class="w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer" />
              <label for="deductFee" id="deductFeeLabel" class="text-sm font-semibold text-slate-700 cursor-pointer">
                Credit service fee toward final job total on completed revenue
              </label>
            </div>

            <!-- Input 2: Average Revenue per Closed Sale / Treatment -->
            <div class="space-y-2">
              <label for="jobValue" id="jobValueLabel" class="block text-sm font-semibold text-slate-700">Average Job Ticket</label>
              <div class="relative rounded-lg shadow-sm">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500 font-semibold">$</div>
                <input type="number" id="jobValue" min="0" step="any" value="500" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-8 pr-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
              </div>
            </div>

            <!-- Input 3: Max Capacity (Per Week) -->
            <div class="space-y-2">
              <label for="maxCapacity" id="maxCapacityLabel" class="block text-sm font-semibold text-slate-700">How Many Service Calls Can Your Team Do A Week?</label>
              <input type="number" id="maxCapacity" min="0" step="any" value="25" class="w-full rounded-lg border border-slate-300 bg-white py-3 px-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
            </div>

            <!-- Input 4: Current Volume (Per Week) -->
            <div class="space-y-2">
              <label for="currentVolume" id="currentVolumeLabel" class="block text-sm font-semibold text-slate-700">How Many Service Calls Are You Doing A Week Now?</label>
              <input type="number" id="currentVolume" min="0" step="any" value="20" class="w-full rounded-lg border border-slate-300 bg-white py-3 px-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
            </div>

            <!-- Input 5: Appointment to Sale Close Rate -->
            <div class="space-y-2">
              <label for="closeRate" id="closeRateLabel" class="block text-sm font-semibold text-slate-700">Service Calls That Convert to Jobs (%)</label>
              <div class="relative rounded-lg shadow-sm">
                <input type="number" id="closeRate" min="0" max="100" step="any" value="50" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-4 pr-8 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-slate-500 font-semibold">%</div>
              </div>
            </div>

          </div>

          <!-- Dynamic Output Card -->
          <div class="bg-slate-900 text-white p-8 md:p-10 rounded-2xl shadow-xl space-y-7 text-center border border-slate-800 relative">
            
            <!-- Monthly / Annual Toggle Switch -->
            <div class="flex justify-center items-center gap-2 bg-slate-800/80 p-1.5 rounded-lg w-fit mx-auto text-sm font-bold border border-slate-700">
              <button id="timeMonthly" class="px-4 py-1.5 rounded-md bg-indigo-600 text-white transition-all">Monthly Loss</button>
              <button id="timeAnnual" class="px-4 py-1.5 rounded-md text-slate-400 hover:text-white transition-all">Annual Loss</button>
            </div>

            <div class="space-y-3">
              <div class="text-5xl md:text-6xl font-black text-rose-400 tracking-tight" id="boostOutput">-$6,000</div>
              <div class="text-base md:text-lg text-slate-300 font-medium" id="breakdownOutput">
                <span id="feeRevenueText" class="font-bold text-white">Includes $1,000 in standalone dispatch fees</span>
              </div>
              <p class="text-sm text-slate-400 pt-2 leading-relaxed" id="detailText">
                Based on weekly open capacity scaled to monthly totals (~4.33 weeks/month).
              </p>
            </div>

            <!-- Trust-Building Hover Breakdown Trigger -->
            <div class="relative group inline-block pt-2">
              <button class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-300 hover:text-white transition-colors cursor-pointer bg-slate-800/60 hover:bg-slate-800 px-4 py-2 rounded-full border border-slate-700">
                <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>How is this calculated?</span>
              </button>

              <!-- Popover Content (Reveals on Hover) -->
              <div class="opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-80 p-5 bg-slate-800 text-slate-200 text-sm rounded-xl shadow-2xl border border-slate-700 z-50 text-left space-y-3">
                <div class="font-bold text-white border-b border-slate-700 pb-2 flex justify-between items-center text-base">
                  <span>Calculation Formula</span>
                  <span class="text-xs text-indigo-400 uppercase tracking-wider font-bold" id="hoverTimeLabel">Monthly</span>
                </div>
                <ul class="space-y-2 pt-1 text-sm leading-relaxed text-slate-300">
                  <li class="flex justify-between" id="calcLineFeeLabel">
                    <span id="hoverFeeTitle">Dispatch Fee Income:</span>
                    <strong class="text-rose-300 text-base" id="calcValFee">$1,000</strong>
                  </li>
                  <li class="text-xs text-slate-400 pl-2" id="hoverFeeDetail">
                    (Monthly open slots × fee)
                  </li>

                  <li class="flex justify-between pt-2" id="calcLineJobLabel">
                    <span id="hoverJobTitle">Converted Job Revenue:</span>
                    <strong class="text-rose-300 text-base" id="calcValJob">$5,000</strong>
                  </li>
                  <li class="text-xs text-slate-400 pl-2" id="hoverJobDetail">
                    (Monthly converted revenue × job value)
                  </li>
                </ul>
                <div class="text-xs text-slate-400 pt-2 mt-2 border-t border-slate-700/80 italic">
                  Total Lost Revenue = Fee Revenue + Job Revenue
                </div>
                <!-- Arrow -->
                <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-slate-800 rotate-45 border-r border-b border-slate-700"></div>
              </div>
            </div>
            
            <hr class="border-slate-800" />
            <a id="ctaButton" href="mailto:rohit@familiarchoice.com?subject=Fill%20Unfilled%20Capacity%20Strategy%20Session" class="inline-block w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg transition-all text-base md:text-lg shadow-md">
              Fill Your Schedule With Rohit
            </a>
          </div>
        </div>
      </section>

    </main>

    <!-- Simple Minimal Footer -->
    <footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500">
      &copy; {new Date().getFullYear()} Familiar Choice. All rights reserved.
    </footer>

    <!-- Client-Side Calculator Logic -->
    <script>
      // DOM Elements (Input Boxes)
      const serviceFeeInput = document.getElementById('serviceFee') as HTMLInputElement;
      const deductFeeCheckbox = document.getElementById('deductFee') as HTMLInputElement;
      const jobValueInput = document.getElementById('jobValue') as HTMLInputElement;
      const maxCapacityInput = document.getElementById('maxCapacity') as HTMLInputElement;
      const currentVolumeInput = document.getElementById('currentVolume') as HTMLInputElement;
      const closeRateInput = document.getElementById('closeRate') as HTMLInputElement;

      // Dynamic Labels
      const serviceFeeLabel = document.getElementById('serviceFeeLabel');
      const deductFeeLabel = document.getElementById('deductFeeLabel');
      const jobValueLabel = document.getElementById('jobValueLabel');
      const maxCapacityLabel = document.getElementById('maxCapacityLabel');
      const currentVolumeLabel = document.getElementById('currentVolumeLabel');
      const closeRateLabel = document.getElementById('closeRateLabel');
      const ctaButton = document.getElementById('ctaButton');
      
      const boostOutput = document.getElementById('boostOutput');
      const feeRevenueText = document.getElementById('feeRevenueText');
      const detailText = document.getElementById('detailText');

      // Hover Tooltip Elements
      const hoverTimeLabel = document.getElementById('hoverTimeLabel');
      const hoverFeeTitle = document.getElementById('hoverFeeTitle');
      const calcValFee = document.getElementById('calcValFee');
      const hoverFeeDetail = document.getElementById('hoverFeeDetail');
      const hoverJobTitle = document.getElementById('hoverJobTitle');
      const calcValJob = document.getElementById('calcValJob');
      const hoverJobDetail = document.getElementById('hoverJobDetail');

      // Presets & Time Toggle Elements
      const presetTrade = document.getElementById('presetTrade');
      const presetMedical = document.getElementById('presetMedical');
      const timeMonthly = document.getElementById('timeMonthly');
      const timeAnnual = document.getElementById('timeAnnual');

      let isAnnualView = false;
      let currentMode = 'trade'; // 'trade' or 'medical'

      // Block minus signs, 'e', '+', etc. at the keyboard level
      const numberInputs = [serviceFeeInput, jobValueInput, maxCapacityInput, currentVolumeInput, closeRateInput];
      numberInputs.forEach(input => {
        input?.addEventListener('keydown', (e) => {
          if (['-', 'e', 'E', '+'].includes(e.key)) {
            e.preventDefault();
          }
        });

        // Clean values on input if pasted or forced past keydown
        input?.addEventListener('input', () => {
          let val = parseFloat(input.value);
          if (isNaN(val) || val < 0) {
            input.value = '0';
          }
        });
      });

      function updateCalculator() {
        const fee = Math.max(0, parseFloat(serviceFeeInput.value) || 0);
        const shouldDeduct = deductFeeCheckbox ? deductFeeCheckbox.checked : false;
        const saleValue = Math.max(0, parseFloat(jobValueInput.value) || 0);
        const maxCapWeekly = Math.max(0, parseFloat(maxCapacityInput.value) || 0);
        let currVolWeekly = Math.max(0, parseFloat(currentVolumeInput.value) || 0);
        
        // Prevent current volume from exceeding max capacity logically
        if (currVolWeekly > maxCapWeekly) {
          currVolWeekly = maxCapWeekly;
          currentVolumeInput.value = currVolWeekly.toString();
        }

        let closeRate = Math.max(0, Math.min(100, parseFloat(closeRateInput.value) || 0)) / 100;

        // Weeks per month conversion factor (~4.33 weeks per month)
        const weeksPerMonth = 4.3333;

        // Weekly open slots
        let openSlotsWeekly = maxCapWeekly - currVolWeekly;
        if (openSlotsWeekly < 0) openSlotsWeekly = 0;

        // Monthly scaling based on weekly inputs
        const openSlotsMonthly = openSlotsWeekly * weeksPerMonth;
        const potentialSalesMonthly = openSlotsMonthly * closeRate;
        const unclosedAppointmentsMonthly = openSlotsMonthly - potentialSalesMonthly;

        const feeApplicableMonthly = shouldDeduct ? unclosedAppointmentsMonthly : openSlotsMonthly;
        const baseFeeRevenueMonthly = feeApplicableMonthly * fee;
        const baseSalesRevenueMonthly = potentialSalesMonthly * saleValue;

        const multiplier = isAnnualView ? 12 : 1;
        const totalLostRevenue = (baseFeeRevenueMonthly + baseSalesRevenueMonthly) * multiplier;
        const displayFeeRevenue = baseFeeRevenueMonthly * multiplier;
        const displaySalesRevenue = baseSalesRevenueMonthly * multiplier;

        // Render Card Outputs
        if (boostOutput) {
          boostOutput.textContent = `-$${Math.round(totalLostRevenue).toLocaleString()}`;
        }

        if (feeRevenueText) {
          const feeName = currentMode === 'medical' ? 'consultation fees' : 'dispatch fees';
          if (shouldDeduct) {
            feeRevenueText.textContent = `Includes unclosed ${feeName} credited toward ${currentMode === 'medical' ? 'procedure revenue' : 'job revenue'}`;
          } else {
            feeRevenueText.textContent = `Includes $${Math.round(displayFeeRevenue).toLocaleString()} in standalone ${feeName}`;
          }
        }

        if (detailText) {
          const roundedOpenWeekly = Math.round(openSlotsWeekly * 10) / 10;
          if (currentMode === 'medical') {
            detailText.textContent = `Based on ${roundedOpenWeekly} open weekly consults scaled to monthly totals (~4.33 weeks/mo).`;
          } else {
            detailText.textContent = `Based on ${roundedOpenWeekly} open weekly service calls scaled to monthly totals (~4.33 weeks/mo).`;
          }
        }

        // Render Hover Tooltip Formulas
        if (hoverTimeLabel) hoverTimeLabel.textContent = isAnnualView ? 'Annual' : 'Monthly';

        const feeLabelText = currentMode === 'medical' ? 'Consult Fee Revenue:' : 'Dispatch Fee Revenue:';
        if (hoverFeeTitle) hoverFeeTitle.textContent = feeLabelText;
        if (calcValFee) calcValFee.textContent = `$${Math.round(displayFeeRevenue).toLocaleString()}`;
        
        if (hoverFeeDetail) {
          const totalSlotsScaled = Math.round(feeApplicableMonthly * multiplier);
          hoverFeeDetail.textContent = `(${totalSlotsScaled} ${shouldDeduct ? 'unclosed ' : 'open '}slots × $${fee} fee)`;
        }

        const jobLabelText = currentMode === 'medical' ? 'Procedure Revenue:' : 'Converted Job Revenue:';
        if (hoverJobTitle) hoverJobTitle.textContent = jobLabelText;
        if (calcValJob) calcValJob.textContent = `$${Math.round(displaySalesRevenue).toLocaleString()}`;
        
        if (hoverJobDetail) {
          const totalSalesScaled = Math.round(potentialSalesMonthly * multiplier);
          hoverJobDetail.textContent = `(${totalSalesScaled} converted ${currentMode === 'medical' ? 'procedures' : 'jobs'} × $${saleValue} ${currentMode === 'medical' ? 'procedure value' : 'job value'})`;
        }
      }

      // Dynamic Messaging Switching Logic
      function setTradeMessaging() {
        currentMode = 'trade';
        serviceFeeInput.value = '50';
        jobValueInput.value = '500';
        maxCapacityInput.value = '25';
        currentVolumeInput.value = '20';
        closeRateInput.value = '50';
        if (deductFeeCheckbox) deductFeeCheckbox.checked = false;

        if (serviceFeeLabel) serviceFeeLabel.textContent = "Service Call / Dispatch Fee";
        if (deductFeeLabel) deductFeeLabel.textContent = "Credit service fee toward final job total on completed revenue";
        if (jobValueLabel) jobValueLabel.textContent = "Average Job Ticket";
        if (maxCapacityLabel) maxCapacityLabel.textContent = "How Many Service Calls Can Your Team Do A Week?";
        if (currentVolumeLabel) currentVolumeLabel.textContent = "How Many Service Calls Are You Doing A Week Now?";
        if (closeRateLabel) closeRateLabel.textContent = "Service Calls That Convert to Jobs (%)";
        if (ctaButton) ctaButton.textContent = "Fill Your Schedule With Rohit";

        presetTrade?.setAttribute("class", "preset-btn px-5 py-2.5 text-sm font-bold rounded-full border border-indigo-600 bg-indigo-50 text-indigo-700 transition-all shadow-sm");
        presetMedical?.setAttribute("class", "preset-btn px-5 py-2.5 text-sm font-bold rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-600 hover:text-indigo-600 transition-all shadow-sm");
      }

      function setMedicalMessaging() {
        currentMode = 'medical';
        serviceFeeInput.value = '300';
        jobValueInput.value = '3500';
        maxCapacityInput.value = '15';
        currentVolumeInput.value = '10';
        closeRateInput.value = '40';
        if (deductFeeCheckbox) deductFeeCheckbox.checked = false;

        if (serviceFeeLabel) serviceFeeLabel.textContent = "Initial Consultation / Exam Fee";
        if (deductFeeLabel) deductFeeLabel.textContent = "Credit consultation fee toward final procedure total";
        if (jobValueLabel) jobValueLabel.textContent = "Average Procedure Value (e.g. Implants)";
        if (maxCapacityLabel) maxCapacityLabel.textContent = "How Many Consults Can Your Team Do A Week?";
        if (currentVolumeLabel) currentVolumeLabel.textContent = "How Many Consults Are You Doing A Week Now?";
        if (closeRateLabel) closeRateLabel.textContent = "Case Acceptance Rate (% who book procedures)";
        if (ctaButton) ctaButton.textContent = "Fill Your Patient Schedule With Rohit";

        presetMedical?.setAttribute("class", "preset-btn px-5 py-2.5 text-sm font-bold rounded-full border border-indigo-600 bg-indigo-50 text-indigo-700 transition-all shadow-sm");
        presetTrade?.setAttribute("class", "preset-btn px-5 py-2.5 text-sm font-bold rounded-full border border-slate-200 bg-white text-slate-700 hover:border-indigo-600 hover:text-indigo-600 transition-all shadow-sm");
      }

      // Time View Toggle Handlers
      timeMonthly?.addEventListener('click', () => {
        isAnnualView = false;
        timeMonthly.className = "px-4 py-1.5 rounded-md bg-indigo-600 text-white transition-all";
        timeAnnual?.setAttribute("class", "px-4 py-1.5 rounded-md text-slate-400 hover:text-white transition-all");
        updateCalculator();
      });

      timeAnnual?.addEventListener('click', () => {
        isAnnualView = true;
        timeAnnual.className = "px-4 py-1.5 rounded-md bg-indigo-600 text-white transition-all";
        timeMonthly?.setAttribute("class", "px-4 py-1.5 rounded-md text-slate-400 hover:text-white transition-all");
        updateCalculator();
      });

      // Industry Quick-Presets Handlers
      presetTrade?.addEventListener('click', () => {
        setTradeMessaging();
        updateCalculator();
      });

      presetMedical?.addEventListener('click', () => {
        setMedicalMessaging();
        updateCalculator();
      });

      // Input Event Listeners
      numberInputs.forEach(input => {
        input?.addEventListener('input', updateCalculator);
      });
      deductFeeCheckbox?.addEventListener('change', updateCalculator);

      // Default Initialization
      setTradeMessaging();
      updateCalculator();
    </script>

  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  /* Hide native number input increment/decrement spinners for clean UI */
  input[type=number]::-webkit-inner-spin-button, 
  input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }
  input[type=number] {
    -moz-appearance: textfield;
  }
</style>