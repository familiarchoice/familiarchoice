---
// src/pages/san-antonio.astro
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>San Antonio HVAC Marketing Strategy | Fill Your Dispatch Board | Rohit Singh</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased selection:bg-indigo-100 selection:text-indigo-900">
    
    <!-- Top Navigation -->
    <header class="max-w-5xl mx-auto px-6 py-8 flex justify-between items-center">
      <div class="font-bold text-xl tracking-tight text-slate-900">
        Familiar<span class="text-indigo-600">Choice</span>
      </div>
      <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="/" class="text-slate-600 hover:text-indigo-600 transition-colors">← Home</a>
        <a href="https://www.linkedin.com/in/rohit-singh-atx/" target="_blank" class="hover:text-indigo-600 transition-colors">LinkedIn</a>
        <button id="openModalNav" class="text-slate-600 hover:text-indigo-600 transition-colors cursor-pointer bg-transparent border-0 p-0 font-medium text-sm">Contact</button>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6 pt-6 pb-24 space-y-16">

      <!-- Hero Section -->
      <section class="text-center space-y-8">
        <div class="inline-block px-3 py-1 bg-indigo-50 border border-indigo-100 rounded-full text-indigo-700 text-xs font-semibold uppercase tracking-wider">
          San Antonio HVAC Growth Strategy
        </div>
        
        <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Fill Your San Antonio Dispatch Board and Stop Losing AC Calls to Competitors
        </h1>

        <p class="text-lg md:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
          When South Texas temperatures spike, San Antonio homeowners flood search engines for emergency AC repair. Every empty slot on your board isn't just an unbooked hour—it's high-margin repair and replacement revenue walking straight to a competitor.
        </p>

        <!-- Extra-Large Quotation Headline with Attribution -->
        <div class="max-w-4xl mx-auto space-y-3 pt-2">
          <blockquote class="text-2xl md:text-4xl lg:text-[2.3rem] font-semibold text-slate-800 leading-[1.3] italic tracking-tight">
            "I want to make it so that when someone needs what I do, I'm easy to find and they <strong class="text-indigo-600 font-black not-italic underline decoration-indigo-300 decoration-wavy decoration-1 underline-offset-8">call me first.</strong>"
          </blockquote>
          <p class="text-sm md:text-base font-medium text-slate-500 tracking-wide pt-1">
            — A Very Successful Business Owner
          </p>
        </div>

        <!-- Core Formula Banner -->
        <div class="bg-slate-900 text-white rounded-2xl p-8 shadow-xl max-w-2xl mx-auto mt-6 border border-slate-800">
          <p class="text-xs uppercase tracking-widest text-indigo-400 font-semibold mb-2">The Contractor Formula</p>
          <div class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-2">
            Local Familiarity + Search Visibility = Booked Trucks
          </div>
          <p class="text-slate-400 text-sm md:text-base">
            Are your trucks booked solid, or are you fighting for scraps on price?
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a href="#calculator" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-all">
            Calculate Your San Antonio Revenue Leakage
          </a>
          <button id="openModalHero" class="px-6 py-3 bg-white hover:bg-slate-100 text-slate-700 font-medium rounded-lg border border-slate-200 shadow-sm transition-all cursor-pointer">
            Book a Strategy Chat with Rohit
          </button>
        </div>
      </section>

      <hr class="border-slate-200" />

      <!-- Framework Breakdown Grid tailored for HVAC -->
      <section class="space-y-10">
        <div class="text-center space-y-2">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">The Two Pillars of HVAC Market Dominance</h2>
          <p class="text-slate-600">How San Antonio contractors move past low-margin price shopping into reliable booked capacity.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          
          <!-- Relational Media Card -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-lg">
              01
            </div>
            <h3 class="text-xl font-bold text-slate-900">Relational Media</h3>
            <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide">Build trust across San Antonio *before* emergencies hit</p>
            <p class="text-slate-600 text-sm leading-relaxed">
              Connected TV, local streaming, YouTube, and hyper-targeted digital awareness across Bexar County.
            </p>
            <ul class="space-y-2 text-slate-600 text-sm pt-2">
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                <span>Plants your company name in local neighborhoods long before a system breakdown occurs.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                <span>Ensures homeowners don't just call a stranger, but choose a brand they already know, like, and trust.</span>
              </li>
            </ul>
            <div class="pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
              Goal: Stop getting price-shopped against random directory listings.
            </div>
          </div>

          <!-- Directional Media Card -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-lg">
              02
            </div>
            <h3 class="text-xl font-bold text-slate-900">Directional Media</h3>
            <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide">Capture high-intent search demand</p>
            <p class="text-slate-600 text-sm leading-relaxed">
              Google Local Services Ads, high-intent PPC, and localized search optimization.
            </p>
            <ul class="space-y-2 text-slate-600 text-sm pt-2">
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                Dominate searches like “emergency AC repair near me” or “San Antonio HVAC contractor.”
              </li>
              <li class="flex items-start gap-2">
                <span class="text-indigo-600 font-bold">•</span>
                Directly feed your dispatch board with ready-to-buy service calls.
              </li>
            </ul>
            <div class="pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
              Goal: Make your trucks the easiest to find the exact moment an AC fails.
            </div>
          </div>

        </div>

        <!-- Logic-Driven Convergence Highlight Box -->
        <div class="bg-gradient-to-r from-indigo-900 to-slate-900 text-white p-8 md:p-10 rounded-2xl text-center space-y-6 shadow-lg border border-indigo-800">
          <div class="flex justify-center items-center gap-3 text-sm font-semibold tracking-wider uppercase text-indigo-300">
            <span>Relational</span>
            <span>+</span>
            <span>Directional</span>
            <span>=</span>
            <span class="text-white underline decoration-indigo-400">The Familiar Choice Method™</span>
          </div>
          
          <div class="text-lg md:text-xl text-slate-200 max-w-3xl mx-auto leading-relaxed space-y-4">
            <p>If you're not easy to find when they're looking for an AC company, your competitors get the call.</p>
            <p>If you are easy to find but homeowners don't trust you, you get beaten down on price.</p>
            <p class="font-bold text-white text-xl md:text-2xl pt-3">When you are easy to find AND already trusted across San Antonio... you become the undisputed first call.</p>
          </div>
        </div>
      </section>

      <!-- Revenue Leakage Calculator Section (Pre-loaded for HVAC) -->
      <section id="calculator" class="bg-white p-8 md:p-10 rounded-2xl border border-rose-100 shadow-md space-y-8">
        
        <div class="text-center space-y-3">
          <div class="inline-block px-4 py-1.5 bg-rose-50 border border-rose-100 rounded-full text-rose-700 text-sm font-bold uppercase tracking-wider">
            San Antonio HVAC Calculator
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">How Much Revenue Are Empty Dispatch Slots Costing Your Shop?</h2>
          <p class="text-slate-600 max-w-xl mx-auto text-base md:text-lg">
            Plug in your numbers below to instantly calculate your monthly and annual revenue leakage from unbooked capacity.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-10 items-center pt-4">
          <!-- Controls / Input Fields -->
          <div class="space-y-6">
            
            <!-- Input 1: Dispatch Fee -->
            <div class="space-y-2">
              <label for="serviceFee" class="block text-sm font-semibold text-slate-700">Service Call / Dispatch Fee</label>
              <div class="relative rounded-lg shadow-sm">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500 font-semibold">$</div>
                <input type="number" id="serviceFee" min="0" step="any" value="89" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-8 pr-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
              </div>
            </div>

            <!-- Checkbox: Deduct Fee from Sale -->
            <div class="flex items-center gap-3 pt-1 pb-1">
              <input type="checkbox" id="deductFee" class="w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer" />
              <label for="deductFee" class="text-sm font-semibold text-slate-700 cursor-pointer">
                Credit service fee toward final job total on completed revenue
              </label>
            </div>

            <!-- Input 2: Average Job Ticket -->
            <div class="space-y-2">
              <label for="jobValue" class="block text-sm font-semibold text-slate-700">Average Job Ticket (Repair & Replacement)</label>
              <div class="relative rounded-lg shadow-sm">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-500 font-semibold">$</div>
                <input type="number" id="jobValue" min="0" step="any" value="650" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-8 pr-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
              </div>
            </div>

            <!-- Input 3: Max Capacity -->
            <div class="space-y-2">
              <label for="maxCapacity" class="block text-sm font-semibold text-slate-700">How Many Service Calls Can Your Team Handle A Week?</label>
              <input type="number" id="maxCapacity" min="0" step="any" value="35" class="w-full rounded-lg border border-slate-300 bg-white py-3 px-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
            </div>

            <!-- Input 4: Current Volume -->
            <div class="space-y-2">
              <label for="currentVolume" class="block text-sm font-semibold text-slate-700">How Many Service Calls Are You Doing A Week Now?</label>
              <input type="number" id="currentVolume" min="0" step="any" value="25" class="w-full rounded-lg border border-slate-300 bg-white py-3 px-4 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
            </div>

            <!-- Input 5: Close Rate -->
            <div class="space-y-2">
              <label for="closeRate" class="block text-sm font-semibold text-slate-700">Service Calls That Convert to Completed Jobs (%)</label>
              <div class="relative rounded-lg shadow-sm">
                <input type="number" id="closeRate" min="0" max="100" step="any" value="60" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-4 pr-8 text-slate-900 font-bold focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-slate-500 font-semibold">%</div>
              </div>
            </div>

          </div>

          <!-- Dynamic Output Card -->
          <div class="bg-slate-900 text-white p-8 md:p-10 rounded-2xl shadow-xl space-y-7 text-center border border-slate-800 relative">
            
            <!-- Monthly / Annual Toggle Switch -->
            <div class="flex justify-center items-center gap-2 bg-slate-800/80 p-1.5 rounded-lg w-fit mx-auto text-sm font-bold border border-slate-700">
              <button id="timeMonthly" class="px-4 py-1.5 rounded-md bg-indigo-600 text-white transition-all">Monthly Loss</button>
              <button id="timeAnnual" class="px-4 py-1.5 rounded-md text-slate-400 hover:text-white transition-all">Annual Loss</button>
            </div>

            <div class="space-y-3">
              <div class="text-5xl md:text-6xl font-black text-rose-400 tracking-tight" id="boostOutput">-$12,000</div>
              <div class="text-base md:text-lg text-slate-300 font-medium" id="breakdownOutput">
                <span id="feeRevenueText" class="font-bold text-white">Includes standalone dispatch fees</span>
              </div>
              <p class="text-sm text-slate-400 pt-2 leading-relaxed" id="detailText">
                Based on weekly open capacity scaled to monthly totals (~4.33 weeks/month).
              </p>
            </div>

            <!-- Trust-Building Hover Breakdown Trigger -->
            <div class="relative group inline-block pt-2">
              <button class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-300 hover:text-white transition-colors cursor-pointer bg-slate-800/60 hover:bg-slate-800 px-4 py-2 rounded-full border border-slate-700">
                <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>How is this calculated?</span>
              </button>

              <!-- Popover Content (Reveals on Hover) -->
              <div class="opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-80 p-5 bg-slate-800 text-slate-200 text-sm rounded-xl shadow-2xl border border-slate-700 z-50 text-left space-y-3">
                <div class="font-bold text-white border-b border-slate-700 pb-2 flex justify-between items-center text-base">
                  <span>Calculation Formula</span>
                  <span class="text-xs text-indigo-400 uppercase tracking-wider font-bold" id="hoverTimeLabel">Monthly</span>
                </div>
                <ul class="space-y-2 pt-1 text-sm leading-relaxed text-slate-300">
                  <li class="flex justify-between">
                    <span>Dispatch Fee Income:</span>
                    <strong class="text-rose-300 text-base" id="calcValFee">$0</strong>
                  </li>
                  <li class="text-xs text-slate-400 pl-2" id="hoverFeeDetail">
                    (Monthly open slots × fee)
                  </li>

                  <li class="flex justify-between pt-2">
                    <span>Converted Job Revenue:</span>
                    <strong class="text-rose-300 text-base" id="calcValJob">$0</strong>
                  </li>
                  <li class="text-xs text-slate-400 pl-2" id="hoverJobDetail">
                    (Monthly converted jobs × job value)
                  </li>
                </ul>
                <div class="text-xs text-slate-400 pt-2 mt-2 border-t border-slate-700/80 italic">
                  Total Revenue Leakage = Fee Revenue + Job Revenue
                </div>
                <!-- Arrow -->
                <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-slate-800 rotate-45 border-r border-b border-slate-700"></div>
              </div>
            </div>
            
            <hr class="border-slate-800" />
            <button id="openModalCard" class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg transition-all text-base md:text-lg shadow-md cursor-pointer">
              Fill Your San Antonio Dispatch Board
            </button>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section class="bg-white p-8 md:p-10 rounded-2xl border border-slate-200 shadow-sm space-y-6">
        <h2 class="text-2xl font-bold text-slate-900">About Rohit Singh</h2>
        <p class="text-slate-600 leading-relaxed text-base">
          For 15 years, I have helped local service businesses understand a simple truth: every emergency call is up for grabs. When an AC fails in San Antonio, homeowners don’t just want any provider—they want someone easy to find and someone they already trust. I want to make it so that when someone needs what you do, you're easy to find and they call you first. That’s what <strong class="text-slate-900">The Familiar Choice Method™</strong> is built to achieve.
        </p>
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <span class="text-sm font-medium text-slate-700">Ready to scale your San Antonio HVAC shop?</span>
          <div class="flex gap-3">
            <a href="https://www.linkedin.com/in/rohit-singh-atx/" target="_blank" class="text-sm text-indigo-600 hover:underline font-semibold">LinkedIn</a>
            <span class="text-slate-300">•</span>
            <button id="openModalAbout" class="text-sm text-indigo-600 hover:underline font-semibold bg-transparent border-0 p-0 cursor-pointer">Email Me</button>
          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500 space-y-2">
      <div>
        <a href="/" class="text-indigo-600 hover:underline font-semibold">← Back to Main Strategy Page</a>
      </div>
      <div>
        &copy; {new Date().getFullYear()} Familiar Choice. All rights reserved.
      </div>
    </footer>

    <!-- Netlify Form Hidden Render (Required for Netlify build bots to detect form fields) -->
    <form name="san-antonio-strategy" netlify netlify-honeypot="bot-field" hidden>
      <input type="text" name="name" />
      <input type="text" name="company" />
      <input type="email" name="email" />
      <input type="tel" name="phone" />
      <textarea name="message"></textarea>
    </form>

    <!-- Contact Form Modal Popup -->
    <div id="contactModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden px-4">
      <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-8 relative space-y-6 border border-slate-100 transform transition-all">
        
        <!-- Close Button -->
        <button id="closeModal" class="absolute top-6 right-6 text-slate-400 hover:text-slate-700 text-2xl font-bold cursor-pointer leading-none">×</button>
        
        <div class="space-y-2">
          <h3 class="text-2xl font-extrabold text-slate-900">Schedule a San Antonio HVAC Strategy Session</h3>
          <p class="text-slate-600 text-sm">Fill out the details below and it will securely send your request directly to Rohit at <span class="font-semibold text-slate-900">rohit.singh@localiq.com</span>.</p>
        </div>

        <form id="strategyForm" name="san-antonio-strategy" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-4">
          <input type="hidden" name="form-name" value="san-antonio-strategy" />
          <p class="hidden">
            <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="space-y-1">
            <label for="formName" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Your Name</label>
            <input type="text" id="formName" name="name" required placeholder="e.g. John Smith" class="w-full rounded-lg border border-slate-300 bg-white py-2.5 px-3 text-slate-900 text-sm focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
          </div>

          <div class="space-y-1">
            <label for="formCompany" class="block text-xs font-bold uppercase tracking-wider text-slate-700">HVAC Company Name</label>
            <input type="text" id="formCompany" name="company" required placeholder="e.g. Alamo Air & Heating" class="w-full rounded-lg border border-slate-300 bg-white py-2.5 px-3 text-slate-900 text-sm focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="formEmail" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Your Email</label>
              <input type="email" id="formEmail" name="email" required placeholder="john@alamoair.com" class="w-full rounded-lg border border-slate-300 bg-white py-2.5 px-3 text-slate-900 text-sm focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
            </div>
            <div class="space-y-1">
              <label for="formPhone" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Phone Number</label>
              <input type="tel" id="formPhone" name="phone" placeholder="(210) 000-0000" class="w-full rounded-lg border border-slate-300 bg-white py-2.5 px-3 text-slate-900 text-sm focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" />
            </div>
          </div>

          <div class="space-y-1">
            <label for="formMessage" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Current Dispatch Goals / Challenges</label>
            <textarea id="formMessage" name="message" rows="3" placeholder="Tell me a bit about your current service call volume..." class="w-full rounded-lg border border-slate-300 bg-white py-2.5 px-3 text-slate-900 text-sm focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20"></textarea>
          </div>

          <button type="submit" id="submitBtn" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg transition-all text-base shadow-md cursor-pointer">
            Send Message to Rohit
          </button>
        </form>

        <!-- Success Confirmation State (Hidden by default) -->
        <div id="formSuccess" class="hidden text-center space-y-4 py-6">
          <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
            ✓
          </div>
          <h4 class="text-xl font-bold text-slate-900">Message Sent Successfully!</h4>
          <p class="text-slate-600 text-sm">Thank you for reaching out. Rohit will review your details and get back to you shortly at <span class="font-semibold text-slate-900">rohit.singh@localiq.com</span>.</p>
          <button id="closeSuccess" class="px-6 py-2.5 bg-slate-900 text-white font-medium rounded-lg text-sm cursor-pointer hover:bg-slate-800 transition-all">
            Close Window
          </button>
        </div>

      </div>
    </div>

    <!-- Client-Side Calculator & Netlify Form Modal Logic -->
    <script>
      // Modal Logic Elements
      const contactModal = document.getElementById('contactModal');
      const closeModalBtn = document.getElementById('closeModal');
      const closeSuccessBtn = document.getElementById('closeSuccess');
      const openModalNav = document.getElementById('openModalNav');
      const openModalHero = document.getElementById('openModalHero');
      const openModalCard = document.getElementById('openModalCard');
      const openModalAbout = document.getElementById('openModalAbout');
      const strategyForm = document.getElementById('strategyForm') as HTMLFormElement;
      const formSuccess = document.getElementById('formSuccess');

      function openModal() {
        contactModal?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        contactModal?.classList.add('hidden');
        document.body.style.overflow = 'auto';
        // Reset form view after closing
        setTimeout(() => {
          strategyForm?.classList.remove('hidden');
          formSuccess?.classList.add('hidden');
          strategyForm?.reset();
        }, 300);
      }

      openModalNav?.addEventListener('click', openModal);
      openModalHero?.addEventListener('click', openModal);
      openModalCard?.addEventListener('click', openModal);
      openModalAbout?.addEventListener('click', openModal);
      closeModalBtn?.addEventListener('click', closeModal);
      closeSuccessBtn?.addEventListener('click', closeModal);

      contactModal?.addEventListener('click', (e) => {
        if (e.target === contactModal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
        }
      });

      // Handle Netlify Form Submission via AJAX (Fetch)
      strategyForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';
        }

        const formData = new FormData(strategyForm);

        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as any).toString()
        })
        .then(() => {
          strategyForm?.classList.add('hidden');
          formSuccess?.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message to Rohit';
          }
        })
        .catch((error) => {
          alert('There was a problem submitting your message. Please email directly at rohit.singh@localiq.com');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message to Rohit';
          }
        });
      });

      // Calculator Logic Elements
      const serviceFeeInput = document.getElementById('serviceFee') as HTMLInputElement;
      const deductFeeCheckbox = document.getElementById('deductFee') as HTMLInputElement;
      const jobValueInput = document.getElementById('jobValue') as HTMLInputElement;
      const maxCapacityInput = document.getElementById('maxCapacity') as HTMLInputElement;
      const currentVolumeInput = document.getElementById('currentVolume') as HTMLInputElement;
      const closeRateInput = document.getElementById('closeRate') as HTMLInputElement;

      const boostOutput = document.getElementById('boostOutput');
      const feeRevenueText = document.getElementById('feeRevenueText');
      const detailText = document.getElementById('detailText');

      const hoverTimeLabel = document.getElementById('hoverTimeLabel');
      const calcValFee = document.getElementById('calcValFee');
      const hoverFeeDetail = document.getElementById('hoverFeeDetail');
      const calcValJob = document.getElementById('calcValJob');
      const hoverJobDetail = document.getElementById('hoverJobDetail');

      const timeMonthly = document.getElementById('timeMonthly');
      const timeAnnual = document.getElementById('timeAnnual');

      let isAnnualView = false;

      const numberInputs = [serviceFeeInput, jobValueInput, maxCapacityInput, currentVolumeInput, closeRateInput];
      numberInputs.forEach(input => {
        input?.addEventListener('keydown', (e) => {
          if (['-', 'e', 'E', '+'].includes(e.key)) {
            e.preventDefault();
          }
        });

        input?.addEventListener('input', () => {
          let val = parseFloat(input.value);
          if (isNaN(val) || val < 0) {
            input.value = '0';
          }
        });
      });

      function updateCalculator() {
        const fee = Math.max(0, parseFloat(serviceFeeInput.value) || 0);
        const shouldDeduct = deductFeeCheckbox ? deductFeeCheckbox.checked : false;
        const saleValue = Math.max(0, parseFloat(jobValueInput.value) || 0);
        const maxCapWeekly = Math.max(0, parseFloat(maxCapacityInput.value) || 0);
        let currVolWeekly = Math.max(0, parseFloat(currentVolumeInput.value) || 0);
        
        if (currVolWeekly > maxCapWeekly) {
          currVolWeekly = maxCapWeekly;
          currentVolumeInput.value = currVolWeekly.toString();
        }

        let closeRate = Math.max(0, Math.min(100, parseFloat(closeRateInput.value) || 0)) / 100;
        const weeksPerMonth = 4.3333;

        let openSlotsWeekly = maxCapWeekly - currVolWeekly;
        if (openSlotsWeekly < 0) openSlotsWeekly = 0;

        const openSlotsMonthly = openSlotsWeekly * weeksPerMonth;
        const potentialSalesMonthly = openSlotsMonthly * closeRate;
        const unclosedAppointmentsMonthly = openSlotsMonthly - potentialSalesMonthly;

        const feeApplicableMonthly = shouldDeduct ? unclosedAppointmentsMonthly : openSlotsMonthly;
        const baseFeeRevenueMonthly = feeApplicableMonthly * fee;
        const baseSalesRevenueMonthly = potentialSalesMonthly * saleValue;

        const multiplier = isAnnualView ? 12 : 1;
        const totalLostRevenue = (baseFeeRevenueMonthly + baseSalesRevenueMonthly) * multiplier;
        const displayFeeRevenue = baseFeeRevenueMonthly * multiplier;
        const displaySalesRevenue = baseSalesRevenueMonthly * multiplier;

        if (boostOutput) {
          boostOutput.textContent = `-$${Math.round(totalLostRevenue).toLocaleString()}`;
        }

        if (feeRevenueText) {
          if (shouldDeduct) {
            feeRevenueText.textContent = `Includes unclosed dispatch fees credited toward completed job revenue`;
          } else {
            feeRevenueText.textContent = `Includes $${Math.round(displayFeeRevenue).toLocaleString()} in standalone dispatch fees`;
          }
        }

        if (detailText) {
          const roundedOpenWeekly = Math.round(openSlotsWeekly * 10) / 10;
          detailText.textContent = `Based on ${roundedOpenWeekly} open weekly service calls scaled to monthly totals (~4.33 weeks/mo).`;
        }

        if (hoverTimeLabel) hoverTimeLabel.textContent = isAnnualView ? 'Annual' : 'Monthly';
        if (calcValFee) calcValFee.textContent = `$${Math.round(displayFeeRevenue).toLocaleString()}`;
        
        if (hoverFeeDetail) {
          const totalSlotsScaled = Math.round(feeApplicableMonthly * multiplier);
          hoverFeeDetail.textContent = `(${totalSlotsScaled} ${shouldDeduct ? 'unclosed ' : 'open '}slots × $${fee} fee)`;
        }

        if (calcValJob) calcValJob.textContent = `$${Math.round(displaySalesRevenue).toLocaleString()}`;
        
        if (hoverJobDetail) {
          const totalSalesScaled = Math.round(potentialSalesMonthly * multiplier);
          hoverJobDetail.textContent = `(${totalSalesScaled} converted jobs × $${saleValue} job value)`;
        }
      }

      timeMonthly?.addEventListener('click', () => {
        isAnnualView = false;
        timeMonthly.className = "px-4 py-1.5 rounded-md bg-indigo-600 text-white transition-all";
        timeAnnual?.setAttribute("class", "px-4 py-1.5 rounded-md text-slate-400 hover:text-white transition-all");
        updateCalculator();
      });

      timeAnnual?.addEventListener('click', () => {
        isAnnualView = true;
        timeAnnual.className = "px-4 py-1.5 rounded-md bg-indigo-600 text-white transition-all";
        timeMonthly?.setAttribute("class", "px-4 py-1.5 rounded-md text-slate-400 hover:text-white transition-all");
        updateCalculator();
      });

      numberInputs.forEach(input => {
        input?.addEventListener('input', updateCalculator);
      });
      deductFeeCheckbox?.addEventListener('change', updateCalculator);

      updateCalculator();
    </script>

  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  input[type=number]::-webkit-inner-spin-button, 
  input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }
  input[type=number] {
    -moz-appearance: textfield;
  }
</style>